{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Intelligence Signal",
  "type": "object",
  "required": ["id", "created_at", "type", "claim", "status", "sources", "confidence"],
  "properties": {
    "id": {"type": "string"},
    "created_at": {"type": "string", "format": "date"},
    "type": {"type": "string"},
    "entity": {"type": "object"},
    "claim": {"type": "string"},
    "status": {"enum": ["OBSERVED", "SUPPORTED", "INFERRED", "SPECULATIVE", "UNKNOWN"]},
    "sources": {"type": "array", "items": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string"}, "type": {"type": "string"}, "published_at": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"]}}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "related_product_area": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
